# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL and service-role key: Supabase dashboard → Project Settings → API.
# The service-role key is SERVER-ONLY (never expose it with a NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: not used by V1 (all data access is server-side with the service role).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string used ONLY by `npm run db:migrate` and the DB integration test:
# Supabase dashboard → Connect → "Session pooler" URI (include the database password).
SUPABASE_DB_URL=

# ── Gemini (all runtime AI) ────────────────────────────────────────────────
# Google AI Studio API key.
GOOGLE_GENERATIVE_AI_API_KEY=
# Exact Gemini Flash model id. No default on purpose — run `npm run gemini:models`
# to list the Flash models your key can use, then set one explicitly.
GEMINI_MODEL=

# ── Security ───────────────────────────────────────────────────────────────
# Password for the operator UI (required in production).
ADMIN_PASSWORD=
# Bearer token that protects /api/cron/pipeline. Generate: openssl rand -hex 32
CRON_SECRET=

# ── Outreach identity (used in generated drafts) ───────────────────────────
OUTREACH_SENDER_NAME=Rohit
ACCELERATOR_NAME=

# ── Gmail draft integration (optional; without it, drafts are stored in Supabase) ──
# OAuth client + refresh token with the gmail.compose scope. See README → Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Pipeline tuning (optional) ─────────────────────────────────────────────
PIPELINE_MAX_ARTICLES_PER_RUN=40
PIPELINE_CONCURRENCY=2
PIPELINE_TIME_BUDGET_SECONDS=240
