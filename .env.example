# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL and service-role key: Supabase dashboard → Project Settings → API.
# The service-role key is SERVER-ONLY (never expose it with a NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: not used by V1 (all data access is server-side with the service role).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string used ONLY by `npm run db:migrate` and the DB integration test:
# Supabase dashboard → Connect → "Session pooler" URI (include the database password).
SUPABASE_DB_URL=

# ── Gemini (all runtime AI) ────────────────────────────────────────────────
# Google AI Studio API key.
GOOGLE_GENERATIVE_AI_API_KEY=
# Exact Gemini Flash model id. No default on purpose — run `npm run gemini:models`
# to list the Flash models your key can use, then set one explicitly.
GEMINI_MODEL=

# ── Security ───────────────────────────────────────────────────────────────
# Bearer token that protects /api/cron/pipeline. Generate: openssl rand -hex 32
CRON_SECRET=

# ── Outreach identity (used in generated drafts) ───────────────────────────
OUTREACH_SENDER_NAME=Rohit
ACCELERATOR_NAME=

# ── Gmail draft integration (optional; without it, drafts are stored in Supabase) ──
# OAuth client + refresh token with the gmail.compose scope. See README → Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Pipeline tuning (optional) ─────────────────────────────────────────────
PIPELINE_MAX_ARTICLES_PER_RUN=40
PIPELINE_CONCURRENCY=2
PIPELINE_TIME_BUDGET_SECONDS=240

# ── Contact discovery (all optional; baseline works with none of these) ─────
# Raises GitHub's public-API limit from ~60 to 5000 requests/hour. A token with NO scopes is enough.
GITHUB_TOKEN=
# Optional free-tier Hunter key: only used to verify guessed/weakly-attributed founder addresses.
HUNTER_API_KEY=
# CONTACT_MAX_PAGES=8
# CONTACT_CONCURRENCY=3
# CONTACT_REENRICH_DAYS=14
# CONTACT_SEARCH_MONTHLY_BUDGET=400
# CONTACT_VERIFIER_MONTHLY_BUDGET=40
# CONTACT_BACKFILL_PER_RUN=5

# ── Sending (Resend) — only used by the "Send" button on an approved draft ──
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. rohit@yourdomain.com
RESEND_FROM_EMAIL=
# Display name shown to recipients (defaults to OUTREACH_SENDER_NAME)
# RESEND_FROM_NAME=
# Where replies go if different from the from-address
# RESEND_REPLY_TO=
